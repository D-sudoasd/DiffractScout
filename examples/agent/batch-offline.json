{
  "schema": "diffractscout_batch_v1",
  "max_workers": 1,
  "requests": [
    {
      "schema": "diffractscout_workflow_v1",
      "workflow": "analyze",
      "name": "Batch synthetic laboratory reference",
      "inputs": ["../demo_cifs/synthetic_fcc_al.cif"],
      "analysis": {
        "input_mode": "source",
        "source_preset": "Cu Ka",
        "two_theta_min_deg": 5.0,
        "two_theta_max_deg": 100.0,
        "include_elasticity": false
      },
      "exports": {"include_excel": false}
    },
    {
      "schema": "diffractscout_workflow_v1",
      "workflow": "prepare_analyze",
      "name": "Batch offline TC4 alpha reference",
      "composition": "TC4",
      "preparation": {"offline": true, "phases": ["alpha"]},
      "analysis": {
        "input_mode": "source",
        "source_preset": "Cu Ka",
        "two_theta_min_deg": 5.0,
        "two_theta_max_deg": 100.0,
        "include_elasticity": false
      },
      "exports": {"include_excel": false}
    }
  ]
}
